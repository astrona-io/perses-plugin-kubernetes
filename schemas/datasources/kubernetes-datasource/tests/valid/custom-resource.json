{
  "kind": "KubernetesDatasource",
  "spec": {
    "proxy": {
      "kind": "HTTPProxy",
      "spec": {
        "url": "https://kubernetes.default.svc",
        "timeout": "30s",
        "secret": "k8s",
        "allowedEndpoints": [
          {
            "endpointPattern": "^/api/v1/namespaces$",
            "method": "GET"
          },
          {
            "endpointPattern": "^/apis/example\\.com/v1/(namespaces/[a-z0-9]([-a-z0-9]*[a-z0-9])?/)?widgets$",
            "method": "GET"
          }
        ]
      }
    }
  }
}
